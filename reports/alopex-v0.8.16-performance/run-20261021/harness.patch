new file mode 100644
index 00000000..a13aea0c
--- /dev/null
+++ b/scripts/performance/test_parity_v0816_measure.py
@@ -0,0 +1,130 @@
+import json
+import os
+from pathlib import Path
+import sqlite3
+import sys
+import tempfile
+import types
+import unittest
+from unittest.mock import patch
+
+sys.path.insert(0, str(Path(__file__).parent))
+import parity_v0811_measure as measure
+
+
+class Transaction:
+    def __init__(self, connection):
+        self.connection = connection
+        self.connection.execute("BEGIN")
+
+    def execute_sql(self, sql):
+        return self.connection.execute_sql(sql)
+
+    def savepoint(self, name):
+        self.connection.actions.append("savepoint")
+        self.connection.execute(f"SAVEPOINT {name}")
+
+    def rollback_to(self, name):
+        self.connection.actions.append("rollback_to")
+        self.connection.execute(f"ROLLBACK TO {name}")
+
+    def release(self, name):
+        self.connection.savepoint_state = self.connection.execute(
+            "SELECT value FROM bench WHERE id = 0"
+        ).fetchone()
+        self.connection.actions.append("release")
+        self.connection.execute(f"RELEASE {name}")
+
+    def rollback(self):
+        self.connection.rollback()
+
+
+class EmbeddedAdapter:
+    def __init__(self):
+        self.connection = sqlite3.connect(":memory:", isolation_level=None)
+        self.actions = []
+
+    def execute(self, sql):
+        return self.connection.execute(sql)
+
+    def execute_sql(self, sql):
+        cursor = self.execute(sql)
+        if cursor.description:
+            columns = [item[0] for item in cursor.description]
+            return [dict(zip(columns, row)) for row in cursor.fetchall()]
+        return cursor.rowcount
+
+    def prepare(self, sql):
+        connection = self
+        class Prepared:
+            def bind(self, position, value):
+                self.value = value
+            def execute(self):
+                return connection.execute_sql(sql.replace("?", str(self.value)))
+            def finalize(self):
+                pass
+        return Prepared()
+
+    def begin(self, mode):
+        return Transaction(self)
+
+    def rollback(self):
+        self.connection.rollback()
+
+
+class MeasureTests(unittest.TestCase):
+    def test_embedded_sqlite_contract_uses_savepoints_and_preserves_state(self):
+        connection = EmbeddedAdapter()
+        measure._populate_sql(connection, "alopex", 10)
+        measure._prepare_sql_workload(connection, "alopex", "sql-sqlite-curated")
+        module = types.SimpleNamespace(TxnMode=types.SimpleNamespace(READ_WRITE=1))
+        with patch.dict(sys.modules, alopex=module):
+            measure._validate_sql_state(connection, "alopex", "sql-sqlite-curated", 10)
+            measure._sql_workload(connection, "alopex", "sql-sqlite-curated", 10)
+            measure._validate_sql_state(connection, "alopex", "sql-sqlite-curated", 10)
+        self.assertEqual(connection.actions, ["savepoint", "rollback_to", "release"])
+        self.assertEqual(connection.savepoint_state, (0.0,))
+
+    def test_sqlite_workload_preserves_fixture_after_rollback(self):
+        connection = sqlite3.connect(":memory:", isolation_level=None)
+        measure._populate_sql(connection, "sqlite", 10)
+        measure._prepare_sql_workload(connection, "sqlite", "sql-sqlite-curated")
+        before = measure._validate_sql_state(connection, "sqlite", "sql-sqlite-curated", 10)
+        measure._sql_workload(connection, "sqlite", "sql-sqlite-curated", 10)
+        self.assertEqual(measure._validate_sql_state(connection, "sqlite", "sql-sqlite-curated", 10), before)
+
+    def test_checksum_normalizes_sequence_containers(self):
+        self.assertEqual(measure._result_checksum({"id": [1, 2]}),
+                         measure._result_checksum({"id": (1, 2)}))
+
+    def test_execute_consumes_returning_cursor(self):
+        connection = sqlite3.connect(":memory:")
+        connection.execute("CREATE TABLE items (id INTEGER)")
+        self.assertEqual(measure._execute(connection, "sqlite", "INSERT INTO items VALUES (1) RETURNING id"), [(1,)])
+        self.assertEqual(measure._execute(connection, "sqlite", "SELECT id FROM items"), [(1,)])
+
+    def test_state_validation_rejects_changed_data(self):
+        connection = sqlite3.connect(":memory:", isolation_level=None)
+        measure._populate_sql(connection, "sqlite", 10)
+        measure._prepare_sql_workload(connection, "sqlite", "sql-sqlite-curated")
+        measure._validate_sql_state(connection, "sqlite", "sql-sqlite-curated", 10)
+        connection.execute("UPDATE bench SET value = 99 WHERE id = 0")
+        with self.assertRaises(RuntimeError):
+            measure._validate_sql_state(connection, "sqlite", "sql-sqlite-curated", 10)
+
+    def test_samples_flush_ndjson_after_each_sample(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "case.ndjson"
+            observations = []
+            def operation():
+                observations.append(len(path.read_text().splitlines()) if path.exists() else 0)
+            with patch.dict(os.environ, ALOPEX_PERF_RAW_PATH=str(path)):
+                samples = measure._samples(operation, 1, 3)
+            records = [json.loads(line) for line in path.read_text().splitlines()]
+            self.assertEqual(observations, [0, 0, 1, 2])
+            self.assertEqual([row["seconds"] for row in records], samples)
+            self.assertEqual([row["sample"] for row in records], [0, 1, 2])
+
+
+if __name__ == "__main__":
+    unittest.main()
